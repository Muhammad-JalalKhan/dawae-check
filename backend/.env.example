# ── Database ────────────────────────────────────────────────────────
# Supabase pooler URL. URL-encode special chars in the password (e.g. @ → %40).
# Note: the Supabase pooler username format is postgres.<project-ref>.
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ── AI Model (DashScope / Alibaba Cloud Model Studio) ──────────────
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://ws-b973pux4uxag20i2.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
AI_MODEL_NAME=qwen-vl-plus

# Set to "true" for local dev with hardcoded responses, "false" for live AI inference
MOCK_AI_ENGINE=false
