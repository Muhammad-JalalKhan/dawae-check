# ── Database ────────────────────────────────────────────────────────
# Supabase pooler URL. URL-encode special chars in the password (e.g. @ → %40)
DATABASE_URL=postgresql+asyncpg://postgres.yourproject:YOUR%40PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ── AI Model (DashScope or OpenRouter) ─────────────────────────────
DASHSCOPE_API_KEY=sk-your-api-key-here
DASHSCOPE_BASE_URL=https://ws-xxxx.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
AI_MODEL_NAME=qwen-vl-plus

# Set to "true" for local dev with hardcoded responses, "false" for live AI inference
MOCK_AI_ENGINE=false
